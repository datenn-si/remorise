# Remorise の設定は2層に分かれています。
#
# 基底層 — 常に.env から読みます。
# データベースができる前に必要な値（接続先、データの場所）なので、
# 設定画面からは変更できません。
#
# 運用層 — 設定画面から変更できる項目の初期値です。
# データベースに保存された値が、ここに書いた値より優先されます。


# ---- 基底層 ----

# ---- LLM の接続 (設定必須) ----
# LLM の接続です。
# 既定値はないため、未指定だと起動時にエラーになります。
# コメントを外して、自分の環境の値を書いてください（値は例です）。

# 接続先
# LLM_BASE_URL=http://127.0.0.1:9931/v1

# API キー
# LLM_API_KEY=local

# 接続先の LLM サーバーで使うモデル名
# LLM_MODEL=

# ---- LLM の接続設定ここまで ----

# ユーザーデータの場所です。
# 既定はドキュメントフォルダの Remorise フォルダです。
# REMORISE_DATA_DIR=C:/Users/you/Documents/Remorise

# 動かすキャラクターの ID（データディレクトリの characters/ 配下の
# フォルダ名）です。
# 既定は remora で、起動引数 --character でも選べます。
# REMORISE_CHARACTER_ID=remora

# データベースのプロファイル名（半角英数字、大文字は小文字に統一）です。
# 指定するとキャラクターのフォルダ内の remorise.<プロファイル>.db を使い、
# 起動引数 --profile でも選べます。未指定なら remorise.db です。
# REMORISE_PROFILE=

# キャラクターのフォルダ内の remorise.db 以外のデータベースを
# 使う場合だけ設定します。
# DATABASE_URL=sqlite+aiosqlite:///./remorise.db



# ---- 運用層 ----

# 以下は初期値です。
# 設定画面から変更でき（データベースに保存されます）、データベースの値が
# ここに書いた値より優先されます。
# このファイルを編集しても、データベースで上書きされていない項目には
# そのまま効きます。

LLM_CONTEXT_SIZE=16384
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=300

# メイン生成のサンプリング。すべて任意です。
# 未設定なら llama.cpp サーバー側の既定のままになります。
# LLM_TEMPERATURE=0.8
# LLM_FREQUENCY_PENALTY=0
# LLM_PRESENCE_PENALTY=0
# LLM_REPEAT_PENALTY=1.0

CONTEXT_WARNING_RATIO=0.70
CONTEXT_SUMMARY_RATIO=0.75
CONTEXT_TARGET_RATIO=0.55
SUMMARY_PROTECTED_MESSAGES=20

EMOTION_HALF_LIFE_MINUTES=30

AFFINITY_MIN=0
AFFINITY_MAX=200
AFFINITY_DELTA_LIMIT=5

MEMORY_AGENT_MAX_CALLS=8
MEMORY_AGENT_TIMEOUT_SECONDS=60

MEMORY_HANDOVER_LIMIT=5
MEMORY_HANDOVER_TOKEN_BUDGET=1500
MEMORY_RESIDENT_MAX_ITEMS=20
MEMORY_SIMILARITY_THRESHOLD=0.8

JOB_MAX_ATTEMPTS=3
JOB_POLL_INTERVAL_SECONDS=5

# 立ち絵モーション: 立ち絵は合成した1枚全体で動きます（全レイヤーに
# 同じ変換をかけ、レイヤー同士がずれることはありません）。大きさと
# 速さは倍率（1 = レンダラーの標準量、0 = なし）で、オーバースキャン
# は動いている間も端が隠れるよう少し拡大します。立ち絵デバッグ画面
# （/sprites）でプレビューしながら調整できます。
SPRITE_MOTION_ENABLED=true
SPRITE_MOTION_AMPLITUDE=1.0
SPRITE_MOTION_SPEED=1.0
SPRITE_MOTION_OVERSCAN=1.06

# データライフサイクル — これらも初期値で、同じ設定画面から変更できます
# （デバッグ画面は読み取り専用です）。
# アーカイブ済み履歴を自動で物理削除するまでの日数。0 = 手動の削除のみ。
ARCHIVE_RETENTION_DAYS=0
RAW_LOG_RETENTION_DAYS=30

# 記憶の忘却: 保持スコアは、その記憶のカテゴリの半減期で減衰します
# （出来事は時点、状態は期間）。MEMORY_DECAY_THRESHOLD を下回った記憶が
# 忘れられます。
MEMORY_DECAY_ENABLED=true
MEMORY_DECAY_THRESHOLD=0.2
MEMORY_HALF_LIFE_EVENT_DAYS=30
MEMORY_HALF_LIFE_STATE_DAYS=365
MEMORY_REACTIVATION_FACTOR=1.5
MEMORY_REACTIVATION_MAX_MULTIPLIER=10
